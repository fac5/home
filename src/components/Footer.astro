---
import { ChevronUp } from '@lucide/astro';
import { filings, internetSites, nav, site, socialLinks, type SocialLink } from '@/config/site';
import { assetIfExists } from '@/lib/assets';
import { getFilingIcon, socialIcons } from '@/lib/icons';
import { externalAttrs } from '@/lib/links';

const currentYear = new Date().getFullYear();
const yearLabel = currentYear > site.startYear ? `${site.startYear}–${currentYear}` : `${site.startYear}`;

/**
 * 页脚中间那行导航。
 * 站外站点取自 internetSites（Files 这种标了 muted 的基础设施入口不放进来），
 * 站内页面取自 nav，但跳过 About——顶部导航和首页都能进，页脚不重复。
 * 想加、减或换顺序，改 site.ts 里的 internetSites / nav 就行。
 */
const footerNav = [
  ...internetSites
    .filter((item) => item.external && !item.muted)
    .map((item) => ({ label: item.title, href: item.href, external: true })),
  ...nav
    .filter((item) => item.href !== '/about')
    .map((item) => ({ label: item.label, href: item.href, external: false })),
];

/** 还没填 href 的社交链接直接不渲染，不会留下一排空位 */
const socials = socialLinks.filter((link): link is SocialLink & { href: string } => Boolean(link.href));

/**
 * 备案图标：'/' 开头的是 public 下的图片文件，其它当成内置图标名（见 lib/icons.ts）。
 * 只要有一条带图标，就给每条都留出同样的图标位，两行文字才会对齐。
 */
const filingIcons = filings.map((filing) => {
  if (!filing.icon) return undefined;

  if (filing.icon.startsWith('/')) {
    const src = assetIfExists(filing.icon);
    return src ? { src } : undefined;
  }

  const Icon = getFilingIcon(filing.icon);
  return Icon ? { Icon } : undefined;
});
const reserveFilingIcon = filingIcons.some(Boolean);

const copyright = [`© ${yearLabel} ${site.name}.`, site.copyrightNote].filter(Boolean).join(' ');

const navLink = 'text-sm text-ink-soft transition-colors hover:text-ink';
const iconButton =
  'inline-flex size-9 items-center justify-center rounded-full text-ink-soft transition-colors hover:text-ink';
---

<footer class="mt-14 border-t border-line bg-surface-muted md:mt-16">
  <div class="wrap flex flex-col gap-8 py-10 md:py-12 lg:flex-row lg:items-center lg:justify-between lg:gap-x-4">
    <!-- 左：站点信息 -->
    <a href="/" class="flex shrink-0 items-center gap-2.5" aria-label={`${site.name} 首页`}>
      <img src="/favicon.svg" alt="" aria-hidden="true" width="22" height="22" class="size-[22px]" />
      <span class="flex flex-col">
        <span class="font-serif text-lg leading-tight tracking-tight text-ink">{site.name}</span>
        <span class="mt-1 text-sm leading-snug text-ink-soft">{site.tagline}</span>
      </span>
    </a>

    <!-- 中：导航 + 版权 -->
    <div class="flex min-w-0 flex-col gap-3 lg:flex-1 lg:items-center">
      <nav class="w-full lg:w-auto" aria-label="页脚导航">
        <ul class="flex flex-wrap items-center gap-x-2 gap-y-1.5 lg:justify-center">
          {
            footerNav.map((item, index) => (
              <li class="flex items-center gap-x-2">
                {index > 0 && (
                  <span aria-hidden="true" class="text-ink-faint">
                    ·
                  </span>
                )}
                <a href={item.href} {...externalAttrs(item.external)} class={navLink}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
      <p class="text-xs text-ink-faint">{copyright}</p>
    </div>

    <!-- 右：社交 / 备案 / 返回顶部 -->
    <div class="flex shrink-0 flex-wrap items-center justify-between gap-x-5 gap-y-4 lg:flex-nowrap lg:justify-end">
      <ul class="order-1 flex items-center gap-1">
        {
          socials.map((link) => {
            const Icon = socialIcons[link.icon];
            return (
              <li>
                <a href={link.href} {...externalAttrs(true)} aria-label={link.label} class={iconButton}>
                  <Icon size={18} aria-hidden="true" />
                </a>
              </li>
            );
          })
        }
      </ul>

      <!-- 手机上跟在图标后面，桌面端用 order 挪到最右边 -->
      <button
        type="button"
        data-back-to-top
        hidden
        class="order-2 inline-flex size-9 items-center justify-center rounded-full bg-ink/5 text-ink-soft transition-colors hover:bg-ink/10 hover:text-ink lg:order-4"
        aria-label="回到页面顶部"
      >
        <ChevronUp size={18} aria-hidden="true" />
      </button>

      <span aria-hidden="true" class="order-2 hidden h-9 w-px bg-ink/10 lg:block"></span>

      <ul class="order-3 flex basis-full flex-col gap-1.5 text-xs text-ink-faint lg:basis-auto">
        {
          filings.map((filing, index) => {
            const icon = filingIcons[index];
            const Icon = icon && 'Icon' in icon ? icon.Icon : undefined;
            return (
              <li>
                <a
                  href={filing.href}
                  {...externalAttrs(true)}
                  class="inline-flex items-center gap-1.5 transition-colors hover:text-ink-soft"
                >
                  {icon && 'src' in icon && (
                    <img
                      src={icon.src}
                      alt=""
                      width="62"
                      height="67"
                      class="h-3.5 w-auto shrink-0"
                      loading="lazy"
                      decoding="async"
                    />
                  )}
                  {Icon && <Icon size={14} class="shrink-0" aria-hidden="true" />}
                  {!icon && reserveFilingIcon && <span aria-hidden="true" class="size-3.5 shrink-0"></span>}
                  {filing.text}
                </a>
              </li>
            );
          })
        }
      </ul>
    </div>
  </div>
</footer>

<script>
  const topButton = document.querySelector<HTMLButtonElement>('[data-back-to-top]');

  if (topButton) {
    // 页面短到不需要滚动时就不显示，省得多一个没用的控件
    const update = () => {
      topButton.hidden = document.documentElement.scrollHeight - window.innerHeight <= 320;
    };

    update();
    window.addEventListener('resize', update);
    // 不写死 behavior，交给 CSS 的 scroll-behavior（已经照顾了 prefers-reduced-motion）
    topButton.addEventListener('click', () => window.scrollTo({ top: 0 }));
  }
</script>
