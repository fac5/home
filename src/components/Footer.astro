---
import { filings, site, socialLinks } from '@/config/site';
import { assetIfExists } from '@/lib/assets';

const currentYear = new Date().getFullYear();
const yearLabel = currentYear > site.startYear ? `${site.startYear}–${currentYear}` : `${site.startYear}`;

/** 页脚只保留最重要的几个入口，不堆信息 */
const links = [
  { label: 'Blog', href: 'https://blog.fivk.cn', external: true },
  { label: 'Gallery', href: 'https://photo.fivk.cn', external: true },
  { label: 'Projects', href: '/projects', external: false },
  ...socialLinks
    .filter((link) => link.href)
    .map((link) => ({ label: link.label, href: link.href as string, external: true })),
];
---

<footer class="mt-14 border-t border-line md:mt-16">
  <div class="wrap flex flex-col gap-6 py-8 sm:flex-row sm:items-start sm:justify-between">
    <div>
      <p class="font-serif text-base text-ink">{site.name}</p>
      <p class="mt-1.5 text-sm text-ink-soft">{site.tagline}</p>

      {
        filings.length > 0 && (
          <ul class="mt-2.5 flex flex-wrap items-center gap-x-4 gap-y-1.5 text-xs text-ink-faint">
            {filings.map((filing) => {
              const icon = filing.icon ? assetIfExists(filing.icon) : undefined;
              return (
                <li>
                  <a
                    href={filing.href}
                    rel="noopener"
                    class="inline-flex items-center gap-1.5 transition-colors hover:text-accent"
                  >
                    {icon && (
                      <img
                        src={icon}
                        alt=""
                        width="62"
                        height="67"
                        class="h-3.5 w-auto shrink-0"
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                    {filing.text}
                  </a>
                </li>
              );
            })}
          </ul>
        )
      }
    </div>

    <div class="flex flex-col gap-2.5 sm:items-end">
      <ul class="flex flex-wrap items-center gap-x-4 gap-y-1.5 text-sm text-ink-soft">
        {
          links.map((link) => (
            <li>
              <a
                href={link.href}
                rel={link.external ? 'noopener' : undefined}
                class="transition-colors hover:text-accent"
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
      <p class="text-xs text-ink-faint">© {yearLabel} {site.name}</p>
    </div>
  </div>
</footer>