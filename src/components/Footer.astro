---
import { ArrowUp, ArrowUpRight } from '@lucide/astro';
import { filings, internetSites, nav, site, socialLinks, type SocialLink } from '@/config/site';
import { assetIfExists } from '@/lib/assets';
import { socialIcons } from '@/lib/icons';

const currentYear = new Date().getFullYear();
const yearLabel = currentYear > site.startYear ? `${site.startYear}–${currentYear}` : `${site.startYear}`;

/** 页脚里只放站外入口，站内页面交给旁边的 Explore，不重复堆一遍 */
const elsewhere = internetSites.filter((item) => item.external);

/** 还没填地址的社交链接直接不渲染，不会留下一排空位 */
const socials = socialLinks.filter((link): link is SocialLink & { href: string } => Boolean(link.href));

const columnLabel = 'text-xs tracking-[0.14em] text-ink-faint uppercase';
const navLink = 'text-sm text-ink-soft transition-colors hover:text-ink';
const iconButton =
  'inline-flex size-9 items-center justify-center rounded-full border border-line text-ink-faint transition-colors hover:border-ink/20 hover:text-ink';
---

<footer class="mt-14 border-t border-line md:mt-16">
  <div class="wrap grid gap-x-8 gap-y-10 py-12 md:py-14 lg:grid-cols-12">
    <div class="lg:col-span-4">
      <a
        href="/"
        class="font-serif text-lg tracking-tight text-ink transition-colors hover:text-accent"
        aria-label={`${site.name} 首页`}
      >
        {site.name}
      </a>
      <p class="mt-3 max-w-xs text-sm leading-6 text-ink-soft">{site.tagline}</p>
    </div>

    <div class="grid grid-cols-2 gap-x-6 gap-y-10 lg:contents">
      <nav class="lg:col-span-2" aria-label="页脚导航">
        <p class={columnLabel}>Explore</p>
        <ul class="mt-4 flex flex-col gap-2.5">
          {
            nav.map((item) => (
              <li>
                <a href={item.href} class={navLink}>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <nav class="lg:col-span-3" aria-label="我的其他站点">
        <p class={columnLabel}>My Internet</p>
        <ul class="mt-4 flex flex-col gap-2.5">
          {
            elsewhere.map((item) => (
              <li>
                <a href={item.href} rel="noopener" class:list={['group inline-flex items-center gap-1', navLink]}>
                  {item.title}
                  <ArrowUpRight
                    size={13}
                    class="text-ink-faint transition-transform group-hover:translate-x-0.5"
                    aria-hidden="true"
                  />
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>

    <div class="flex items-start justify-between gap-6 lg:col-span-3 lg:justify-end">
      {
        socials.length > 0 && (
          <ul class="flex items-center gap-1.5">
            {socials.map((link) => {
              const Icon = socialIcons[link.icon];
              return (
                <li>
                  <a href={link.href} rel="noopener" aria-label={link.label} class={iconButton}>
                    <Icon size={16} aria-hidden="true" />
                  </a>
                </li>
              );
            })}
          </ul>
        )
      }

      <button type="button" data-back-to-top hidden class={iconButton} aria-label="回到页面顶部">
        <ArrowUp size={16} aria-hidden="true" />
      </button>
    </div>
  </div>

  <div class="wrap">
    <div
      class="flex flex-col gap-2.5 border-t border-line py-6 text-xs text-ink-faint sm:flex-row sm:items-center sm:justify-between sm:gap-6"
    >
      <p>© {yearLabel} {site.name}</p>

      {
        filings.length > 0 && (
          <ul class="flex flex-wrap items-center gap-x-5 gap-y-2">
            {filings.map((filing) => {
              const icon = filing.icon ? assetIfExists(filing.icon) : undefined;
              return (
                <li>
                  <a
                    href={filing.href}
                    rel="noopener"
                    class="inline-flex items-center gap-1.5 transition-colors hover:text-ink-soft"
                  >
                    {icon && (
                      <img
                        src={icon}
                        alt=""
                        width="62"
                        height="67"
                        class="h-3.5 w-auto shrink-0"
                        loading="lazy"
                        decoding="async"
                      />
                    )}
                    {filing.text}
                  </a>
                </li>
              );
            })}
          </ul>
        )
      }
    </div>
  </div>
</footer>

<script>
  const topButton = document.querySelector<HTMLButtonElement>('[data-back-to-top]');

  if (topButton) {
    // 页面短到不需要滚动时就不显示，省得多一个没用的控件
    const update = () => {
      topButton.hidden = document.documentElement.scrollHeight - window.innerHeight <= 320;
    };

    update();
    window.addEventListener('resize', update);
    // 不写死 behavior，交给 CSS 的 scroll-behavior（已经照顾了 prefers-reduced-motion）
    topButton.addEventListener('click', () => window.scrollTo({ top: 0 }));
  }
</script>
