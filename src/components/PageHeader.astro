---
interface Props {
  title: string;
  /** 标题下面的一段话 */
  lead?: string;
  /** 小字，例如最后更新时间 */
  meta?: string;
}

const { title, lead, meta } = Astro.props;
---

<header class="wrap pt-12 pb-8 md:pt-16 md:pb-10" data-reveal>
  <h1 class="font-serif text-3xl tracking-tight text-ink sm:text-4xl">{title}</h1>
  {lead && <p class="mt-4 max-w-2xl text-base leading-7 text-ink-soft">{lead}</p>}
  {meta && <p class="mt-3 text-xs tracking-wide text-ink-faint">{meta}</p>}
</header>