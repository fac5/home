---
import { ArrowUpRight } from '@lucide/astro';
import { formatDate } from '@/lib/date';
import type { Post } from '@/lib/posts';

interface Props {
  posts: Post[];
  /** 读不到文章时，引导去博客 */
  blogUrl: string;
}

const { posts, blogUrl } = Astro.props;
---

{
  posts.length > 0 ? (
    <ul class="border-t border-line" data-reveal>
      {posts.map((post) => (
        <li class="border-b border-line">
          <a
            href={post.href}
            rel="noopener"
            class="group flex flex-col gap-1.5 py-4 sm:flex-row sm:items-baseline sm:gap-6"
          >
            <time datetime={post.date.toISOString()} class="shrink-0 text-xs text-ink-faint tabular-nums sm:w-20">
              {formatDate(post.date)}
            </time>
            <span class="min-w-0 flex-1">
              <span class="flex items-start gap-1.5 font-medium text-ink transition-colors group-hover:text-accent">
                {post.title}
                <ArrowUpRight
                  size={14}
                  class="mt-1 shrink-0 text-ink-faint transition-colors group-hover:text-accent"
                  aria-hidden="true"
                />
              </span>
              {post.summary && (
                <span class="mt-1.5 line-clamp-2 block text-sm leading-6 text-ink-soft">{post.summary}</span>
              )}
            </span>
          </a>
        </li>
      ))}
    </ul>
  ) : (
    <p class="rounded-xl border border-dashed border-line px-5 py-6 text-sm leading-6 text-ink-soft" data-reveal>
      暂时没读到博客文章。{' '}
      <a href={blogUrl} rel="noopener" class="text-ink underline decoration-accent/50 underline-offset-4 hover:text-accent">
        直接去博客看看
      </a>
    </p>
  )
}