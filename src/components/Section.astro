---
import { ArrowRight, ArrowUpRight } from '@lucide/astro';
import { externalAttrs } from '@/lib/links';

interface Props {
  id?: string;
  title: string;
  description?: string;
  /** 标题右侧的「更多」链接 */
  href?: string;
  linkLabel?: string;
  external?: boolean;
}

const { id, title, description, href, linkLabel = '查看全部', external = false } = Astro.props;
const Icon = external ? ArrowUpRight : ArrowRight;
---

<section id={id} class="wrap py-10 md:py-14">
  <div class="flex flex-wrap items-end justify-between gap-x-6 gap-y-2" data-reveal>
    <div>
      <h2 class="text-lg font-semibold tracking-tight text-ink sm:text-xl">{title}</h2>
      {description && <p class="mt-2 max-w-xl text-sm leading-6 text-ink-soft">{description}</p>}
    </div>

    {
      href && (
        <a
          href={href}
          {...externalAttrs(external)}
          class="group inline-flex items-center gap-1 text-sm text-ink-soft transition-colors hover:text-accent"
        >
          {linkLabel}
          <Icon size={14} class="transition-transform group-hover:translate-x-0.5" aria-hidden="true" />
        </a>
      )
    }
  </div>

  <div class="mt-6 md:mt-8">
    <slot />
  </div>
</section>
