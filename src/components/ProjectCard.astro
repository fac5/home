---
import { ArrowRight } from '@lucide/astro';

interface Props {
  href: string;
  title: string;
  description: string;
  tags?: string[];
  status?: 'active' | 'wip' | 'paused';
}

const { href, title, description, tags = [], status = 'active' } = Astro.props;

const statusLabels: Record<NonNullable<Props['status']>, string> = {
  active: '进行中',
  wip: '施工中',
  paused: '暂缓',
};

const statusStyles: Record<NonNullable<Props['status']>, string> = {
  active: 'border-accent/30 bg-accent-soft text-accent',
  wip: 'border-line bg-surface-muted text-ink-soft',
  paused: 'border-line text-ink-faint',
};
---

<a
  href={href}
  class="group flex h-full flex-col justify-between gap-5 rounded-xl border border-line bg-surface p-5 transition duration-300 hover:-translate-y-0.5 hover:border-ink/15 hover:shadow-[0_12px_32px_-22px_rgb(0_0_0/0.45)]"
>
  <div>
    <div class="flex items-start justify-between gap-3">
      <h3 class="font-medium text-ink transition-colors group-hover:text-accent">{title}</h3>
      <span class:list={['shrink-0 rounded-full border px-2 py-0.5 text-xs', statusStyles[status]]}>
        {statusLabels[status]}
      </span>
    </div>
    <p class="mt-2 text-sm leading-6 text-ink-soft">{description}</p>
  </div>

  <div class="flex items-end justify-between gap-3">
    <ul class="flex flex-wrap gap-1.5">
      {tags.slice(0, 4).map((tag) => <li class="chip !px-2 !text-[0.7rem]">{tag}</li>)}
    </ul>
    <ArrowRight
      size={15}
      class="mb-0.5 shrink-0 text-ink-faint transition-all group-hover:translate-x-0.5 group-hover:text-ink"
      aria-hidden="true"
    />
  </div>
</a>