---
import { ArrowUpRight } from '@lucide/astro';
import { heroActions, site } from '@/config/site';
import { assetIfExists } from '@/lib/assets';
import { siteIcons } from '@/lib/icons';

/** 关掉 Hero 图片时（site.showHeroImage = false），这一块会变成纯文字的单列排版 */
const withImage = site.showHeroImage;
const heroSrc = assetIfExists(site.heroImage, site.heroImageFallback) ?? site.heroImageFallback;
/** 还是占位图的时候，开发模式下给个提示（线上不会显示） */
const showPlaceholderHint = import.meta.env.DEV && withImage && heroSrc !== site.heroImage;
---

<section
  class:list={[
    'wrap',
    withImage ? 'pt-12 pb-10 sm:pt-16 md:pt-20 md:pb-16' : 'pt-14 pb-14 sm:pt-20 md:pt-24 md:pb-24',
  ]}
>
  <div class:list={['grid items-center gap-10', withImage && 'md:grid-cols-12 md:gap-x-12']}>
    <div class:list={[withImage ? 'md:col-span-7' : 'max-w-2xl']} data-reveal>
      <h1 class="font-serif text-5xl leading-none tracking-tight text-ink sm:text-6xl">{site.name}</h1>
      <p class="mt-5 text-lg leading-relaxed text-ink-soft sm:text-xl">{site.tagline}</p>

      <ul class="mt-6 flex flex-wrap gap-2">
        {site.heroTags.map((tag) => <li class="chip">{tag}</li>)}
      </ul>

      <div class="mt-8 flex flex-wrap items-center gap-3">
        {
          heroActions.map((action, index) => {
            const Icon = siteIcons[action.icon ?? 'globe'];
            return (
              <a
                href={action.href}
                rel="noopener"
                class:list={[
                  'btn',
                  index === 0
                    ? 'bg-ink text-canvas hover:bg-ink/90'
                    : 'border border-line text-ink hover:border-ink/25 hover:bg-surface-muted',
                ]}
              >
                <Icon size={15} aria-hidden="true" />
                {action.title}
                <ArrowUpRight size={14} class="opacity-60" aria-hidden="true" />
              </a>
            );
          })
        }
      </div>
    </div>

    {
      withImage && (
        <figure class="md:col-span-5" data-reveal style="--reveal-delay: 120ms">
          <div class="overflow-hidden rounded-2xl border border-line bg-surface-muted">
            <img
              src={heroSrc}
              alt={site.heroImageAlt}
              width="1200"
              height="1500"
              fetchpriority="high"
              decoding="async"
              class="aspect-[4/3] w-full object-cover transition-transform duration-700 ease-out hover:scale-[1.02] sm:aspect-[16/10] md:aspect-[4/5]"
            />
          </div>

          {showPlaceholderHint && (
            <figcaption class="mt-3 text-xs text-ink-faint">
              当前是占位图，把照片放到 public/images/hero.jpg 就会自动替换这里。
            </figcaption>
          )}
        </figure>
      )
    }
  </div>
</section>