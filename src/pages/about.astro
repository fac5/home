---
import { getCollection, render } from 'astro:content';
import PageHeader from '@/components/PageHeader.astro';
import { site } from '@/config/site';
import BaseLayout from '@/layouts/BaseLayout.astro';

const entry = (await getCollection('about'))[0];
const { Content } = await render(entry);
const { title, lead, interests, updated } = entry.data;
---

<BaseLayout title={title} description={lead ?? site.description}>
  <PageHeader title={title} lead={lead} meta={updated ? `最后更新 ${updated}` : undefined} />

  <div class="wrap pb-8">
    {
      interests.length > 0 && (
        <ul class="flex flex-wrap gap-2" data-reveal>
          {interests.map((interest) => <li class="chip">{interest}</li>)}
        </ul>
      )
    }

    <div class="prose mt-10 max-w-2xl" data-reveal>
      <Content />
    </div>
  </div>
</BaseLayout>