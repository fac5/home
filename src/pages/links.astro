---
import { ArrowUpRight } from '@lucide/astro';
import PageHeader from '@/components/PageHeader.astro';
import SiteCard from '@/components/SiteCard.astro';
import { internetSites, socialLinks } from '@/config/site';
import { friendLinks, friendLinksNote } from '@/data/links';
import BaseLayout from '@/layouts/BaseLayout.astro';
import { externalAttrs } from '@/lib/links';

const description = '我自己的几个站点，还有一些朋友的博客。';
const socials = socialLinks.filter((link) => link.href);
---

<BaseLayout title="Links" description={description}>
  <PageHeader title="Links" lead={description} />

  <div class="wrap space-y-14 pb-8">
    <section data-reveal>
      <h2 class="text-base font-semibold tracking-tight text-ink">Me</h2>
      <ul class="mt-4 grid gap-4 sm:grid-cols-2">
        {internetSites.map((item) => <li class="h-full"><SiteCard item={item} /></li>)}
      </ul>

      {
        socials.length > 0 && (
          <ul class="mt-4 flex flex-wrap gap-2">
            {socials.map((social) => (
              <li>
                <a
                  href={social.href as string}
                  {...externalAttrs(true)}
                  class="chip transition-colors hover:border-ink/25 hover:text-ink"
                >
                  {social.label}
                </a>
              </li>
            ))}
          </ul>
        )
      }
    </section>

    <section data-reveal>
      <h2 class="text-base font-semibold tracking-tight text-ink">Internet Friends</h2>

      {
        friendLinks.length > 0 ? (
          <ul class="mt-4 grid gap-3 sm:grid-cols-2">
            {friendLinks.map((friend) => (
              <li>
                <a
                  href={friend.href}
                  {...externalAttrs(true)}
                  class="group flex items-start justify-between gap-3 rounded-xl border border-line bg-surface p-4 transition duration-300 hover:-translate-y-0.5 hover:border-ink/15"
                >
                  <span>
                    <span class="block font-medium text-ink transition-colors group-hover:text-accent">{friend.title}</span>
                    {friend.description && <span class="mt-1 block text-sm text-ink-soft">{friend.description}</span>}
                  </span>
                  <ArrowUpRight size={15} class="mt-1 shrink-0 text-ink-faint" aria-hidden="true" />
                </a>
              </li>
            ))}
          </ul>
        ) : (
          <p class="mt-4 rounded-xl border border-dashed border-line px-5 py-6 text-sm leading-6 text-ink-soft">
            {friendLinksNote}
          </p>
        )
      }
    </section>
  </div>
</BaseLayout>
