---
import { getCollection, render } from 'astro:content';
import PageHeader from '@/components/PageHeader.astro';
import BaseLayout from '@/layouts/BaseLayout.astro';

const entry = (await getCollection('uses'))[0];
const { Content } = await render(entry);
const { title, lead, updated, groups } = entry.data;
---

<BaseLayout title={title} description={lead}>
  <PageHeader title={title} lead={lead} meta={updated ? `最后更新 ${updated}` : undefined} />

  <div class="wrap space-y-10 pb-8">
    {
      groups.map((group) => (
        <section data-reveal>
          <h2 class="text-base font-semibold tracking-tight text-ink">{group.title}</h2>
          {group.description && <p class="mt-2 text-sm leading-6 text-ink-soft">{group.description}</p>}

          {group.items.length > 0 ? (
            <ul class="mt-4 border-t border-line">
              {group.items.map((item) => (
                <li class="flex flex-col gap-1 border-b border-line py-3 sm:flex-row sm:items-baseline sm:gap-6">
                  <span class="text-[0.95rem] text-ink sm:w-56 sm:shrink-0">{item.name}</span>
                  {item.note && <span class="text-sm leading-6 text-ink-soft">{item.note}</span>}
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-4 rounded-lg border border-dashed border-line px-4 py-3 text-sm text-ink-faint">待补充</p>
          )}
        </section>
      ))
    }

    <div class="prose max-w-2xl" data-reveal>
      <Content />
    </div>
  </div>
</BaseLayout>