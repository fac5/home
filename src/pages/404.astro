---
import { ArrowRight } from '@lucide/astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="没有这个页面" description="你要找的页面不在这里。" noindex>
  <section class="wrap flex flex-col items-start py-20 md:py-28" data-reveal>
    <p class="font-serif text-5xl leading-none tracking-tight text-ink">404</p>
    <h1 class="mt-6 text-xl font-semibold tracking-tight text-ink">这里好像没有东西</h1>
    <p class="mt-3 max-w-md text-sm leading-6 text-ink-soft">你要找的页面可能已经被移走了，也可能从来就没有过。回首页看看别的吧。</p>
    <a href="/" class="btn mt-8 bg-ink text-canvas hover:bg-ink/90">
      回首页
      <ArrowRight size={15} aria-hidden="true" />
    </a>
  </section>
</BaseLayout>